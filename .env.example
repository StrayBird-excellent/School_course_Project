# Copy to ".env" (do not commit .env). 通义千问 / DashScope API key（二选一即可）
DASHSCOPE_API_KEY=
# 若你使用阿里云控制台常见的变量名，也可用下面这一项代替上一行：
# ALIYUN_API_KEY=

# Optional: default qwen-turbo; try qwen-plus or qwen-max if your account supports them.
# QWEN_MODEL=qwen-turbo

# Optional: use international endpoint if your key is registered outside mainland China.
# DASHSCOPE_API_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/text-generation/generation

# Flask 会话密钥（必填，生产环境务必使用强随机值）
SECRET_KEY=change-me-to-a-strong-random-string

# 管理员账号（仅从环境变量读取，禁止硬编码；未配置则管理员登录关闭）
ADMIN_PHONE=
ADMIN_PASSWORD=

# 可选：本地部署的大模型（OpenAI 兼容接口），默认 http://localhost:11434
# LOCAL_MODEL_URL=http://localhost:11434/v1/chat/completions
# LOCAL_MODEL_NAME=gemma3:27b
